{
  "expo": {
    "name": "Portal da Vila",
    "slug": "portal-vila",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "portalvila",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O Portal da Vila usa suas fotos para anexar ao relato de um problema ou a um comprovante.",
          "cameraPermission": "O Portal da Vila usa a câmera para fotografar o problema ou o comprovante."
        }
      ],
      "expo-notifications"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7FAFC"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "http://localhost:8080/api"
    }
  }
}
